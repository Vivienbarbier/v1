{
  "manifest_version": 3,
  "name": "LinkedIn Local CRM",
  "description": "Enregistre dans une base locale les profils LinkedIn que vous consultez.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LinkedIn Local CRM",
    "default_popup": "popup.html"
  }
}
